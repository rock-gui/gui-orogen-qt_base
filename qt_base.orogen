# frozen_string_literal: true

name 'qt_base'

OroGen::Spec::Deployment.register_global_initializer(:qt_base)
if defined?(OroGen::Gen::RTT_CPP::Deployment)
    OroGen::Gen::RTT_CPP::Deployment.register_global_initializer(
        :qt_base,
        global_scope: <<~QT_GLOBAL_SCOPE,
            namespace qt_base {
                void globalInitializerInit();
                void globalInitializerExit();
            }
        QT_GLOBAL_SCOPE
        init: <<~QT_INIT_CODE,
            qt_base::globalInitializerInit();
        QT_INIT_CODE
        exit: <<~QT_EXIT_CODE,
            qt_base::globalInitializerExit();
        QT_EXIT_CODE
        tasks_cmake: <<~QT_DEPLOYMENT_CMAKE,
            find_package(Qt4 REQUIRED)
            include(${QT_USE_FILE})
            include_directories(${QT_INCLUDE_DIR})
            link_directories(${QT_LIBRARY_DIR})
            set(CMAKE_AUTOMOC true)
        QT_DEPLOYMENT_CMAKE
        deployment_cmake: <<~QT_DEPLOYMENT_CMAKE
            find_package(Qt4 REQUIRED)
            include(${QT_USE_FILE})
            include_directories(${QT_INCLUDE_DIR})
            link_directories(${QT_LIBRARY_DIR})
            target_link_libraries(<%= deployer.name %> ${QT_LIBRARIES})
            set(CMAKE_AUTOMOC true)
        QT_DEPLOYMENT_CMAKE
    )
end

task_context 'Task' do
    needs_configuration
    needs_global_initializer :qt_base
end

task_context 'test::TestTask', subclasses: 'qt_base::Task' do
end

task_context 'test::ErrorTestTask', subclasses: 'qt_base::Task' do
end
